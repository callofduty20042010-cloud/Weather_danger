{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Activate venv in CMD",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\activate.bat",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "clear": false
      }
    }
  ]
}